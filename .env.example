# Leave empty for local dev and same-origin proxy deployments.
# Set this to http://<public-host>:8080 only when the deployed frontend talks to
# a separately exposed backend gateway.
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_USE_DEV_PROXY=false
VITE_STUN_URLS=
VITE_TURN_CREDENTIALS_URL=
VITE_TURN_API_KEY=
VITE_TURN_REGION=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
FRONTEND_PUBLIC_PORT=5173
PING_MESSAGE=ping
